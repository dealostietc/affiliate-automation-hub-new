# ==============================================================================
# Sasta Maal Pipeline Configuration Environment Variables
# ==============================================================================

# --- Application & Environment ---
APP_ENV=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# --- Ingestion: Engine A (Telegram Userbot Listener) ---
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION_NAME=sasta_maal_userbot
# Comma-separated usernames or channel IDs to monitor
SOURCE_CHANNELS=@deals_india,@looter_deals,@flash_sales_in

# --- Ingestion: Engine B (Target Scrapers & Residential Proxies) ---
# Rotating residential proxy URL (e.g., http://user:pass@gate.smartproxy.com:7000)
PROXY_URL=
SCRAPER_MIN_DISCOUNT_PERCENT=70
SCRAPER_POLL_INTERVAL_SECONDS=300

# --- Deduplication Engine ---
DEDUP_WINDOW_HOURS=6
MIN_PRICE_DROP_PERCENT=5.0

# --- Affiliate Engine ---
# Amazon Associates Tracking ID (e.g. tag-21)
AMAZON_ASSOCIATE_TAG=sastamaal-21

# EarnKaro API Credentials (for Flipkart, Myntra, Ajio)
EARNKARO_API_KEY=
EARNKARO_API_URL=https://api.earnkaro.com/v1/tools/make-links

# Cuelinks API Credentials (Alternative failover aggregator)
CUELINKS_API_KEY=
CUELINKS_CHANNEL_ID=
CUELINKS_API_URL=https://api.cuelinks.com/v2/links.json

# --- Broadcaster: Telegram Channel Bot ---
# Official Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
# Target broadcast channel/chat ID (e.g. @sasta_maal_deals or -100xxxxxxxxxx)
TELEGRAM_BROADCAST_CHANNEL_ID=@sasta_maal_deals

# --- Broadcaster: WhatsApp Distribution ---
# Mode: "baileys" (Group / Community mode) or "cloud_api" (Official Meta Cloud API)
WHATSAPP_MODE=baileys

# WhatsApp Baileys Microservice URL (Node.js service)
WHATSAPP_BAILEYS_ENDPOINT=http://localhost:3001/send-deal
# Comma-separated JIDs for target groups (e.g., 120363023456789012@g.us)
WHATSAPP_GROUP_JIDS=120363023456789012@g.us

# WhatsApp Meta Cloud API (Used if WHATSAPP_MODE=cloud_api)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
